# GEMINI_API_KEY: Required for Gemini AI product recognition, packaging OCR & Live Voice.
# Configured server-side only (never exposed to browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The HTTPS URL where this application is hosted.
APP_URL="MY_APP_URL"

# Server Port (must be 3000 in AI Studio)
PORT=3000

# SQLite Database Path
DATABASE_PATH="./fresh_vibe.db"

# Trusted CORS origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,https://localhost:3000"

# Optional fixed Device Key for ESP32-CAM Cloud API Relay
# Leave blank to auto-generate and manage the key in SQLite / Connect Camera UI.
ESP32_DEVICE_KEY=""
